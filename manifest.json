{
  "manifest_version": 3,
  "name": "Page Visibility API Blocker",
  "version": "1.2",
  "description": "Blocks the Page Visibility API to prevent websites from detecting when the page is hidden",
  "permissions": ["storage"],
  "icons": {
    "16": "Icon.png",
    "48": "Icon.png",
    "128": "Icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "Icon.png",
      "48": "Icon.png",
      "128": "Icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["state_injector.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["blocker.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}

